@article{li2026llm_tsad_survey,
  title={A Survey of Large Language Models for Time Series Anomaly Detection: Methods, Challenges, and Future Directions},
  author={Li, Kunqi and Pitts, Thomas and Liang, Bin and Huang, Chenya and Lu, Yuxi},
  year={2026},
  month={January},
  abstract={Time-series anomaly detection (TSAD) is central to finance, cybersecurity, industrial automation, and healthcare, where identifying rare and irregular events is essential for ensuring safety and operational reliability. Although deep learning has advanced TSAD, existing methods remain limited in interpretability, adaptability, and the ability to incorporate domain knowledge. The emergence of large language models (LLMs) offers new opportunities, as their strengths in reasoning, abstraction, and knowledge integration extend beyond natural language to structured and temporal data. This survey provides the first systematic examination of LLM-based approaches for TSAD and closely related tasks such as fault detection, fraud detection, and intrusion detection, consolidating a rapidly growing and fragmented body of literature. We introduce a unified taxonomy that categorizes existing methods into three paradigms according to the functional role of the LLM: LLM-assisted anomaly detection, where LLMs augment conventional detectors; LLM-centered anomaly detection, where LLMs directly participate in representation learning and anomaly reasoning; and LLM-based anomaly detection agents, where LLMs coordinate multi-step detection and diagnosis workflows. Beyond taxonomy, we identify key open challenges that currently limit the practical adoption of LLMs for TSAD, including modeling multivariate dependencies in complex systems, insufficient evaluation across LLM architectures, and the scarcity of multimodal datasets aligning time series with semantic context.},
  journal={SSRN Preprint},
  html={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6033215},
  bibtex_show={true},
  selected={true},
  abbr={Preprint}
}
